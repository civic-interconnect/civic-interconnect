cff-version: "1.2.0"
message: "If you use this work, please cite it using the metadata in CITATION.cff."
type: software

title: "civic-interconnect"
version: "0.0.7"
date-released: "2026-10-23"

authors:
  - family-names: Case
    given-names: Denise M.
    orcid: "https://orcid.org/0000-0001-6165-7389"
    affiliation: "Northwest Missouri State University, School of Computer Science and Information Systems, Maryville, MO, USA"

repository-code: "https://github.com/civic-interconnect/civic-interconnect"
url: "https://github.com/civic-interconnect/civic-interconnect"

license: MIT

abstract: >
  Civic Interconnect is an open-source specification and implementation
  of the Civic Exchange Protocol (CEP), including schemas, vocabularies,
  canonicalization rules, adapters, and identity mechanisms (SNFEI/EFS).
  It provides a reusable, versioned framework for transforming heterogeneous
  civic datasets into canonical CEP records with strong provenance and
  explanation layers (CEE).

keywords:
  - civic data
  - canonicalization
  - entity resolution
  - provenance
  - transparency
  - data pipelines
  - schema governance

references:
  # Example external datasets used in development, testing, or demonstrations.
  - type: data
    title: "City of Chicago Contracts Dataset"
    authors:
      - name: "City of Chicago"
    year: 2025
    url: "https://data.cityofchicago.org/Administration-Finance/Contracts/rsxa-ify5"
    notes: "Used for testing CEP adapters, canonicalization, and identity normalization. Public Domain."
